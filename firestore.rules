rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolioEntries/{entry} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'arinawj@gmail.com';

      match /chunks/{chunk} {
        allow read: if true;
        allow write: if request.auth != null
          && request.auth.token.email == 'arinawj@gmail.com';
      }
    }
  }
}
